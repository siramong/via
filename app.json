{
  "expo": {
    "name": "VIA",
    "slug": "via",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "via",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-web-browser",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B0F1A"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permite a VIA acceder a tu ubicación para encontrar estaciones de combustible cercanas."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite a VIA acceder a tus fotos.",
          "cameraPermission": "Permite a VIA acceder a tu cámara para capturar displays de surtidores."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.siramong.via",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "VIA necesita acceso a tu ubicación para encontrar el combustible más barato cerca.",
        "NSCameraUsageDescription": "VIA necesita acceso a la cámara para capturar displays de surtidores.",
        "NSPhotoLibraryUsageDescription": "VIA necesita acceso a tus fotos para enviar reportes de precios."
      }
    },
    "android": {
      "package": "com.siramong.via",
      "adaptiveIcon": {
        "backgroundColor": "#0B0F1A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundleUrl": "https://cdn.jsdelivr.net/npm/@react-native-web@0.19"
    },
    "extra": {
      "eas": {
        "projectId": "a233de6b-70a0-4732-ad5e-bf624c38e153"
      }
    },
    "owner": "siramong"
  }
}
